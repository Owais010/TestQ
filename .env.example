# TestQ local configuration. Paths resolve from the repository root.
DATABASE_URL=sqlite+aiosqlite:///./testq.db
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
AI_MODEL=qwen3:8b
AI_ENABLED=true
AI_MAX_GENERATED_TESTS=8
AI_MAX_STRATEGY_ITEMS=6
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT=120.0
AI_PREFLIGHT_TIMEOUT=15.0
AI_PLANNER_TIMEOUT=90.0
AI_GENERATOR_TIMEOUT=120.0
AI_ANALYZER_TIMEOUT=60.0
AI_MAX_OUTPUT_BYTES=262144

# Install/build command bound, whole-run bound, Docker request bound (seconds)
DOCKER_TIMEOUT=600
RUN_TIMEOUT=900
DOCKER_API_TIMEOUT=15
DOCKER_CPU_LIMIT=2
DOCKER_MEMORY_LIMIT=2g

HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
EVIDENCE_DIR=./evidence
WORKSPACES_DIR=./workspaces
LOG_LEVEL=INFO

# Deterministic Phase 2 discovery (seconds for timeout values)
MAX_PAGES=12
MAX_DEPTH=3
NAVIGATION_TIMEOUT=8
ACTION_TIMEOUT=3
DISCOVERY_TIMEOUT=60
DISCOVERY_TRACE_ENABLED=true

# Phase 3 Deterministic test execution limits
MAX_TESTS_PER_RUN=50
MAX_STEPS_PER_TEST=20
TEST_TIMEOUT=30
TEST_ACTION_TIMEOUT=5

