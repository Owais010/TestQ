# ===========================================
# TestQ Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# V1 is 100% local/free — no paid APIs required.
# ===========================================

# Database
DATABASE_URL=sqlite:///./testq.db

# AI Provider (V1: Ollama is default, no paid API needed)
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
AI_MODEL=llama3.1
# OPENAI_API_KEY=sk-...       # Only if using OpenAI (optional)

# Docker Sandbox
DOCKER_TIMEOUT=600
DOCKER_CPU_LIMIT=2
DOCKER_MEMORY_LIMIT=2g

# GitHub (optional — only needed for private repos)
# GITHUB_TOKEN=ghp_...

# Application
HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
EVIDENCE_DIR=./evidence
WORKSPACES_DIR=./workspaces
LOG_LEVEL=INFO
