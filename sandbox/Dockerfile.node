# Build from repository root: docker build -f sandbox/Dockerfile.node ... .
FROM node:22-slim
LABEL testq.hardening="1" testq.browser="1.63.0"
RUN apt-get update && apt-get install -y --no-install-recommends curl git python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* && npm install -g pnpm
COPY sandbox/browser-requirements.txt /opt/testq/browser-requirements.txt
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/testq/browsers
RUN python3 -m venv /opt/testq/venv \
    && /opt/testq/venv/bin/pip install --no-cache-dir -r /opt/testq/browser-requirements.txt \
    && /opt/testq/venv/bin/python -m playwright install --with-deps chromium \
    && /opt/testq/venv/bin/python -c "import site,pathlib; pathlib.Path(site.getsitepackages()[0], 'testq.pth').write_text('/opt/testq/lib')"
RUN groupadd -g 10001 testq && useradd -m -u 10001 -g testq testq \
    && groupadd -g 10002 browser && useradd -m -u 10002 -g browser browser \
    && mkdir -p /workspace /discovery && chown testq:testq /workspace \
    && chown browser:browser /discovery && chmod 700 /discovery
COPY backend/testq_browser /opt/testq/lib/testq_browser
RUN chmod -R a+rX,go-w /opt/testq
WORKDIR /workspace
ENV HOME=/home/testq NODE_ENV=development NEXT_TELEMETRY_DISABLED=1
USER 10001:10001
CMD ["sleep", "600"]
